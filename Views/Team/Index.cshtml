@model IEnumerable<Formula.Models.Team>

<h2>Список Команд</h2>

<a asp-action="Create" class="btn btn-primary">Добавить команду</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Страна</th>
            <th>ID Гонки</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var team in Model)
        {
            <tr>
                <td>@team.TeamId</td>
                <td>@team.Name</td>
                <td>@team.Country</td>
                <td>@team.RaceId</td>
                <td>
                    <form asp-action="Edit" asp-route-id="@team.TeamId" method="get" style="display:inline;">
                        <button type="submit" class="btn btn-warning">Редактировать</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@team.TeamId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
