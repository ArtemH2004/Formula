@model IEnumerable<Formula.Models.Track>

<h2>Список трасс</h2>

<a asp-action="Create" class="btn btn-primary">Добавить трассу</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Фото</th>
            <th>Тип</th>
            <th>Вместимость</th>
            <th>Адрес</th>
            <th>ID Гонки</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var track in Model)
        {
            <tr>
                <td>@track.TrackId</td>
                <td>
                    @if (track.Photo != null)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(track.Photo)" alt="Фото водителя" style="width:35px; height:35px;" />
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>@track.Type</td>
                <td>@track.Capacity</td>
                <td>@track.Address</td>
                <td>@track.RaceId</td>
                <td>
                    <form asp-action="Edit" asp-route-id="@track.TrackId" method="get" style="display:inline;">
                        <button type="submit" class="btn btn-warning">Редактировать</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@track.TrackId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
