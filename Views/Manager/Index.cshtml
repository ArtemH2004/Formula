@model IEnumerable<Formula.Models.Manager>

<h2>Список руководителей</h2>

<a asp-action="Create" class="btn btn-primary">Добавить руководителя</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Должность</th>
            <th>Процент</th>
            <th>ID Команды</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var manager in Model)
        {
            <tr>
                <td>@manager.ManagerId</td>
                <td>@manager.LastName</td>
                <td>@manager.FirstName</td>
                <td>@manager.MiddleName</td>
                <td>@manager.Type</td>
                <td>@manager.Percent</td>
                <td>@manager.TeamId</td>
                <td>
                    <form asp-action="Edit" asp-route-id="@manager.ManagerId" method="get" style="display:inline;">
                        <button type="submit" class="btn btn-warning">Редактировать</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@manager.ManagerId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
