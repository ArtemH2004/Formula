@model Formula.Models.RaceViewModel

<h2>@(Model.RaceId == 0 ? "Создать гонку" : "Редактировать гонку")</h2>

<form asp-action="@(Model.RaceId == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Date">Дата</label>
        <input asp-for="Date" class="form-control" type="date" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StageNumber">Этап</label>
        <input asp-for="StageNumber" class="form-control" />
        <span asp-validation-for="StageNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Type">Тип</label>
        <input asp-for="Type" class="form-control" />
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price">Цена</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AudienceCount">Кол-во зрителей</label>
        <input asp-for="AudienceCount" class="form-control" />
        <span asp-validation-for="AudienceCount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Result">Результат</label>
        <input asp-for="Result" class="form-control" />
        <span asp-validation-for="Result" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Weather">Погода</label>
        <input asp-for="Weather" class="form-control" />
        <span asp-validation-for="Weather" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TrackId">ID Трассы</label>
        <input asp-for="TrackId" class="form-control" />
        <span asp-validation-for="Weather" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="RaceId" />

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>

<a href="@Url.Action("Index")">Назад</a>
