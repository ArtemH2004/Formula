@model IEnumerable<Formula.Models.Race>

<h2>Список гонок</h2>

<a asp-action="Create" class="btn btn-primary">Добавить гонку</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Дата</th>
            <th>Этап</th>
            <th>Тип</th>
            <th>Цена</th>
            <th>Кол-во зрителей</th>
            <th>Результат</th>
            <th>Погода</th>
            <th>ID Трассы</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var race in Model)
        {
            <tr>
                <td>@race.RaceId</td>
                <td>@race.Date.ToShortDateString()</td>
                <td>@race.StageNumber</td>
                <td>@race.Type</td>
                <td>@race.Price</td>
                <td>@race.AudienceCount</td>
                <td>@race.Result</td>
                <td>@race.Weather</td>
                <td>@race.TrackId</td>
                <td>
                    <form asp-action="Edit" asp-route-id="@race.RaceId" method="get" style="display:inline;">
                        <button type="submit" class="btn btn-warning">Редактировать</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@race.RaceId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
