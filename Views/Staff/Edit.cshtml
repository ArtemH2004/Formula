@model Formula.Models.StaffViewModel

<h2>@(Model.StaffId == 0 ? "Создать сотрудника" : "Редактировать сотрудника")</h2>

<form asp-action="@(Model.StaffId == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="LastName">Фамилия</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FirstName">Имя</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Birthday">Дата рождения</label>
        <input asp-for="Birthday" class="form-control" type="date" />
        <span asp-validation-for="Birthday" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Gender">Пол</label>
        <select asp-for="Gender" class="form-control">
            <option value="M">Мужчина</option>
            <option value="F">Женщина</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Job">Должность</label>
        <input asp-for="Job" class="form-control" />
        <span asp-validation-for="Job" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TeamId">ID Команды</label>
        <input asp-for="TeamId" class="form-control" />
        <span asp-validation-for="TeamId" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="StaffId" />

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>

<a href="@Url.Action("Index")">Назад</a>
