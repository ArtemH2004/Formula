@model IEnumerable<Formula.Models.Staff>

<h2>Список сотрудников</h2>

<a asp-action="Create" class="btn btn-primary">Добавить сотрудника</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Дата рождения</th>
            <th>Пол</th>
            <th>Должность</th>
            <th>ID Команды</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var staff in Model)
        {
            <tr>
                <td>@staff.StaffId</td>
                <td>@staff.LastName</td>
                <td>@staff.FirstName</td>
                <td>@staff.Birthday.ToShortDateString()</td>
                <td>@staff.Gender</td>
                <td>@staff.Job</td>
                <td>@staff.TeamId</td>
                <td>
                    <form asp-action="Edit" asp-route-id="@staff.StaffId" method="get" style="display:inline;">
                        <button type="submit" class="btn btn-warning">Редактировать</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@staff.StaffId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
